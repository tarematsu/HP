{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sh-scheduled-collection-jobs",
  "main": "src/scheduled-collection-jobs-entry.js",
  "compatibility_date": "2026-06-24",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1.0,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1.0,
      "persist": true,
      "invocation_logs": true
    }
  },
  "d1_databases": [
    {
      "binding": "OTHER_DB",
      "database_name": "stationhead-other",
      "database_id": "21e70e92-6725-4e62-809e-8aadb088cc11"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PAGES_RESPONSE_R2",
      "bucket_name": "sh-pages-responses"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "stationhead-leaderboard-refresh",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "stationhead-leaderboard-refresh-dlq"
      },
      {
        "queue": "pages-history-refresh",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "pages-history-refresh-dlq",
        "max_batch_timeout": 1
      }
    ],
    "producers": [
      {
        "binding": "HISTORY_READ_MODEL_QUEUE",
        "queue": "pages-history-refresh"
      }
    ]
  }
}
