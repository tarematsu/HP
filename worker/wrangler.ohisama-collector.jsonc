{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sh-ohisama-collector",
  "main": "src/ohisama-pages-entry.js",
  "compatibility_date": "2026-06-24",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "CHANNEL_ALIAS": "ohisama",
    "SH_APP_VERSION": "1.0.0",
    "REQUEST_TIMEOUT_MS": 8000,
    "AUTH_REFRESH_BEFORE_MS": 3600000,
    "OHISAMA_D1_STATE_CHECKPOINT_MS": 3600000
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "r2_buckets": [
    { "binding": "PAGES_RESPONSE_R2", "bucket_name": "sh-pages-responses" }
  ],
  "d1_databases": [
    {
      "binding": "OHISAMA_DB",
      "database_name": "stationhead-ohisama",
      "database_id": "00000000-0000-0000-0000-000000000000"
    },
    {
      "binding": "OTHER_DB",
      "database_name": "stationhead-other",
      "database_id": "21e70e92-6725-4e62-809e-8aadb088cc11"
    }
  ]
}
