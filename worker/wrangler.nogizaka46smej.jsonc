{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sh-nogizaka46smej",
  "main": "src/nogizaka-service-entry.js",
  "compatibility_date": "2026-06-24",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1.0,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1.0,
      "persist": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "SH_APP_VERSION": "1.0.0",
    "SAKURAZAKA_AUTH_STATE_ID": "nogizaka46smej",
    "SOLO_BROADCAST_HANDLE": "nogizaka46smej",
    "OFFICIAL_NEWS_CHECK_INTERVAL_MS": 3600000,
    "OFFICIAL_NEWS_EARLY_WINDOW_MS": 0,
    "OFFICIAL_NEWS_LATE_WINDOW_MS": 5400000,
    "OFFICIAL_NEWS_END_CONFIRM_POLLS": 2,
    "OFFICIAL_NEWS_ARTICLE_LIMIT": 200,
    "OFFICIAL_NEWS_BODY_SCAN_COUNT": 5,
    "REQUEST_TIMEOUT_MS": 8000
  },
  "d1_databases": [
    { "binding": "MINUTE_DB", "database_name": "stationhead-minute", "database_id": "43c12c1e-886d-4496-9c37-61bc8a15bbd7" },
    { "binding": "OTHER_DB", "database_name": "stationhead-other", "database_id": "21e70e92-6725-4e62-809e-8aadb088cc11" }
  ],
  "r2_buckets": [
    { "binding": "PAGES_RESPONSE_R2", "bucket_name": "stationhead-pages-response" }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "stationhead-nogizaka46smej",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 4,
        "dead_letter_queue": "stationhead-nogizaka46smej-dlq",
        "max_concurrency": 1
      }
    ],
    "producers": [
      { "binding": "HOST_MONITOR_QUEUE", "queue": "stationhead-nogizaka46smej" }
    ]
  }
}
