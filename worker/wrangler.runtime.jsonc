{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sh-runtime-orchestrator",
  "main": "src/runtime-orchestrator-deployed-entry.js",
  "compatibility_date": "2026-06-24",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "CHANNEL_ALIAS": "buddies",
    "CHAT_LIMIT": 0,
    "COMMENT_CHAIN_MAX_ATTEMPTS": 1,
    "SH_APP_VERSION": "1.0.0",
    "COLLECTOR_ID": "cloudflare-worker",
    "METADATA_LIMIT": 1,
    "METADATA_REFRESH_INTERVAL_MS": 1800000,
    "COLLECTED_METADATA_PERSIST_ENABLED": false,
    "QUEUE_STABLE_CHECKPOINT_MINUTES": 20,
    "DERIVE_JOB_TIMEOUT_MS": 18000,
    "MINUTE_FACT_TIMEOUT_MS": 0,
    "MINUTE_FACT_POINTER_QUEUE_ENABLED": false,
    "DERIVE_LEASE_MS": 60000,
    "DERIVE_MAX_ATTEMPTS": 4,
    "DERIVE_REVISION_STAGE_TRACKS": 1,
    "DERIVE_REVISION_CHUNK_TRACKS": 20,
    "DERIVE_REVISION_INTERVAL_SECONDS": 20,
    "DERIVE_DISPATCH_LIMIT": 2,
    "DERIVE_REVISION_RECOVERY_LIMIT": 1,
    "DERIVE_REVISION_RECOVERY_STALE_MS": 120000,
    "LIVE_REVISION_MATERIALIZATION_ENABLED": false,
    "LIVE_DERIVE_DIRECT_QUEUE_ENABLED": true,
    "LIVE_DERIVE_INLINE_ENABLED": true,
    "MINUTE_IDENTITY_INLINE_BITE_ENABLED": true,
    "REVISION_PROGRESS_R2_ENABLED": false,
    "MINUTE_FACT_PENDING_ALERT_MS": 900000,
    "MINUTE_FACT_PENDING_ALERT_COUNT": 20,
    "MINUTE_FACT_DEAD_REQUEUE_LIMIT": 100,
    "MINUTE_FACT_STALLED_RECOVERY_LIMIT": 1000,
    "MINUTE_FACT_AUTO_REQUEUE_DEAD": true,
    "PUBLIC_HEALTH_CACHE_MS": 60000,
    "REQUEST_TIMEOUT_MS": 8000
  },
  "kv_namespaces": [
    { "binding": "PAGES_RESPONSE_KV", "id": "00000000000000000000000000000000" }
  ],
  "r2_buckets": [
    { "binding": "PAGES_RESPONSE_R2", "bucket_name": "sh-pages-responses" }
  ],
  "d1_databases": [
    { "binding": "BUDDIES_DB", "database_name": "stationhead-buddies", "database_id": "f361aae0-05f0-42bc-8784-77100e80133d" },
    { "binding": "MINUTE_DB", "database_name": "stationhead-minute", "database_id": "43c12c1e-886d-4496-9c37-61bc8a15bbd7" },
    { "binding": "OTHER_DB", "database_name": "stationhead-other", "database_id": "21e70e92-6725-4e62-809e-8aadb088cc11" }
  ],
  "queues": {
    "consumers": [
      { "queue": "stationhead-minute-enrichment", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 4, "dead_letter_queue": "stationhead-minute-enrichment-dlq", "max_concurrency": 1 },
      { "queue": "stationhead-track-metadata", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 4, "dead_letter_queue": "stationhead-track-metadata-dlq", "max_concurrency": 1 },
      { "queue": "stationhead-minute-derive", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 4, "dead_letter_queue": "stationhead-minute-derive-dlq", "max_concurrency": 1 },
      { "queue": "stationhead-minute-live-derive", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 4, "dead_letter_queue": "stationhead-minute-live-derive-dlq", "max_concurrency": 2 },
      { "queue": "stationhead-buddies-facts", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 4, "dead_letter_queue": "stationhead-buddies-facts-dlq", "max_concurrency": 1 }
    ],
    "producers": [
      { "binding": "MINUTE_FACT_QUEUE", "queue": "stationhead-buddies-facts" },
      { "binding": "MINUTE_LIVE_DERIVE_QUEUE", "queue": "stationhead-minute-live-derive" },
      { "binding": "MINUTE_ENRICHMENT_QUEUE", "queue": "stationhead-minute-enrichment" },
      { "binding": "TRACK_METADATA_QUEUE", "queue": "stationhead-track-metadata" }
    ]
  }
}
