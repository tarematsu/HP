{
  "name": "sh-worker",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.runtime.jsonc --test-scheduled",
    "deploy": "node scripts/deploy-connected-worker.mjs",
    "deploy:buddies-recovery": "node scripts/deploy-buddies-recovery.mjs",
    "deploy:buddies-collector": "node scripts/deploy-buddies-collector.mjs",
    "deploy:sakurazaka46jp": "node scripts/deploy-sakurazaka46jp.mjs",
    "deploy:spotify-playcount": "node scripts/deploy-spotify-playcount.mjs",
    "deploy:amazon-music": "node scripts/deploy-amazon-music.mjs",
    "deploy:runtime": "node scripts/deploy-runtime.mjs",
    "tail": "wrangler tail --config wrangler.runtime.jsonc",
    "check": "npm run check:syntax && npm run check:bundle",
    "check:syntax": "node ../scripts/check-js-syntax.mjs worker/src worker/tests worker/scripts",
    "check:bundle": "npm run check:buddies-recovery-bundle && npm run check:buddies-collector-bundle && npm run check:sakurazaka46jp-bundle && npm run check:spotify-playcount-bundle && npm run check:amazon-music-bundle && npm run check:runtime-bundle",
    "check:buddies-recovery-bundle": "wrangler deploy --config wrangler.buddies-recovery.jsonc --dry-run --outdir=dist-buddies-recovery-dry-run",
    "check:buddies-collector-bundle": "wrangler deploy --config wrangler.buddies-collector.jsonc --dry-run --outdir=dist-buddies-collector-dry-run",
    "check:sakurazaka46jp-bundle": "wrangler deploy --config wrangler.sakurazaka46jp.jsonc --dry-run --outdir=dist-sakurazaka46jp-dry-run",
    "check:spotify-playcount-bundle": "wrangler deploy --config wrangler.spotify-playcount.jsonc --dry-run --outdir=dist-spotify-playcount-dry-run",
    "check:amazon-music-bundle": "wrangler deploy --config wrangler.amazon-music.jsonc --dry-run --outdir=dist-amazon-music-dry-run",
    "check:runtime-bundle": "wrangler deploy --config wrangler.runtime.jsonc --dry-run --outdir=dist-runtime-dry-run",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "sh-shared": "file:../packages/sh-shared"
  },
  "devDependencies": {
    "wrangler": "^4.104.0"
  }
}
