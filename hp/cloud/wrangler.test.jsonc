{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homepanel-test",
  "main": "src/unified_worker.js",
  "compatibility_date": "2026-06-20",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHEDULER_COORDINATOR",
        "class_name": "SchedulerCoordinator"
      },
      {
        "name": "DEVICE_SYNC_COORDINATOR",
        "class_name": "DeviceSyncCoordinator"
      },
      {
        "name": "DEVICE_EXCHANGE_COORDINATOR",
        "class_name": "DeviceExchangeCoordinator"
      },
      {
        "name": "RADAR_BUNDLE_COORDINATOR",
        "class_name": "RadarBundleCoordinator"
      },
      {
        "name": "VIDEO_FEED_COORDINATOR",
        "class_name": "VideoFeedCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "scheduler-coordinator-v1",
      "new_sqlite_classes": [
        "SchedulerCoordinator"
      ]
    },
    {
      "tag": "homepanel-coordinator-split-v1",
      "new_sqlite_classes": [
        "DeviceSyncCoordinator",
        "RadarBundleCoordinator"
      ]
    },
    {
      "tag": "device-exchange-coordinator-v1",
      "new_sqlite_classes": [
        "DeviceExchangeCoordinator"
      ]
    },
    {
      "tag": "integrated-video-feed-coordinator-v1",
      "new_sqlite_classes": [
        "VideoFeedCoordinator"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homepanel-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPDATE_BUCKET",
      "bucket_name": "homepanel-test-updates"
    },
    {
      "binding": "DATA_BUCKET",
      "bucket_name": "homepanel-test-data"
    }
  ]
}
