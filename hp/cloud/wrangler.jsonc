{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homepanel-cloud",
  "main": "src/unified_worker.js",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "WEATHERNEWS_URL": "https://weathernews.jp/onebox/35.8524/139.4852/"
  },
  "assets": {
    "directory": "../video/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/v1",
      "/v1/*",
      "/admin"
    ],
    "not_found_handling": "single-page-application"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHEDULER_COORDINATOR",
        "class_name": "SchedulerCoordinator"
      },
      {
        "name": "DEVICE_SYNC_COORDINATOR",
        "class_name": "DeviceSyncCoordinator"
      },
      {
        "name": "DEVICE_EXCHANGE_COORDINATOR",
        "class_name": "DeviceExchangeCoordinator"
      },
      {
        "name": "RADAR_BUNDLE_COORDINATOR",
        "class_name": "RadarBundleCoordinator"
      },
      {
        "name": "VIDEO_FEED_COORDINATOR",
        "class_name": "VideoFeedCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "scheduler-coordinator-v1",
      "new_sqlite_classes": [
        "SchedulerCoordinator"
      ]
    },
    {
      "tag": "homepanel-coordinator-split-v1",
      "new_sqlite_classes": [
        "DeviceSyncCoordinator",
        "RadarBundleCoordinator"
      ]
    },
    {
      "tag": "device-exchange-coordinator-v1",
      "new_sqlite_classes": [
        "DeviceExchangeCoordinator"
      ]
    },
    {
      "tag": "integrated-video-feed-coordinator-v1",
      "new_sqlite_classes": [
        "VideoFeedCoordinator"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homepanel-data",
      "database_id": "1c8eb0f8-cd73-4156-9ba7-b49bb18f13a3",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPDATE_BUCKET",
      "bucket_name": "homepanel-updates"
    },
    {
      "binding": "DATA_BUCKET"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MANUAL_IMPORT_QUEUE",
        "queue": "videoscraper-manual-imports"
      }
    ],
    "consumers": [
      {
        "queue": "videoscraper-manual-imports",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 5,
        "retry_delay": 300,
        "max_concurrency": 1,
        "dead_letter_queue": "videoscraper-manual-imports-dlq"
      }
    ]
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.5,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.5,
      "persist": true,
      "invocation_logs": true
    }
  }
}
