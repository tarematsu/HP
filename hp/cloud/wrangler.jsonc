{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homepanel-cloud",
  "main": "src/unified_worker.js",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "services": [
    {
      "binding": "VIDEO_SERVICE",
      "service": "homepanel-video"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHEDULER_COORDINATOR",
        "class_name": "SchedulerCoordinator"
      },
      {
        "name": "DEVICE_SYNC_COORDINATOR",
        "class_name": "DeviceSyncCoordinator"
      },
      {
        "name": "RADAR_BUNDLE_COORDINATOR",
        "class_name": "RadarBundleCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "scheduler-coordinator-v1",
      "new_sqlite_classes": [
        "SchedulerCoordinator"
      ]
    },
    {
      "tag": "homepanel-coordinator-split-v1",
      "new_sqlite_classes": [
        "DeviceSyncCoordinator",
        "RadarBundleCoordinator"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homepanel-data",
      "database_id": "1c8eb0f8-cd73-4156-9ba7-b49bb18f13a3",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPDATE_BUCKET",
      "bucket_name": "homepanel-updates"
    },
    {
      "binding": "DATA_BUCKET"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true,
      "invocation_logs": false
    }
  }
}
